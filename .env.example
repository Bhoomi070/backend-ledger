# Server Configuration
PORT=3000
NODE_ENV=development

# Database Connection (MongoDB with replica set for multi-document ACID transactions)
MONGO_URI=mongodb://127.0.0.1:27017/ledger?replicaSet=rs0
# Or MongoDB Atlas URI:
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/ledger?retryWrites=true&w=majority

# Security / JWT
JWT_SECRET=production_grade_super_secret_jwt_key_ledger_2026_fde

# Email Service (Nodemailer OAuth2 / Gmail) - Optional for local dev
EMAIL_USER=your-email@gmail.com
CLIENT_ID=your-google-oauth-client-id
CLIENT_SECRET=your-google-oauth-client-secret
REFRESH_TOKEN=your-google-oauth-refresh-token
